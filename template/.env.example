# Copy to .env.local (gitignored) for local development. In production set these in
# Vercel (Settings → Environment Variables) WITHOUT surrounding quotes.
# Generate fresh keys with: python scripts/gen_keys.py  — never reuse another server's.

# ── Upstream OAuth app (leave empty when the upstream login is BYOT) ─────────────
UPSTREAM_CLIENT_ID=
UPSTREAM_CLIENT_SECRET=
# Optional: point at a sandbox API instead of the pinned UPSTREAM_API_BASE.
UPSTREAM_API_BASE_URL=
# Local stdio login: must be registered as a redirect URI on the upstream app.
LOCAL_REDIRECT_URI=http://localhost:8765/oauth/callback

# ── Production (Vercel) ──────────────────────────────────────────────────────────
PUBLIC_BASE_URL=
# Optional override; defaults to PUBLIC_BASE_URL + /oauth/callback.
UPSTREAM_OAUTH_REDIRECT_URI=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TOKEN_ENCRYPTION_KEY=
MCP_JWT_PRIVATE_KEY=
CRON_SECRET=
OAUTH_RATE_LIMIT_PER_MIN=30
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
